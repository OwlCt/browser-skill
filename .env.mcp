# Dedicated settings for the stdio MCP server. No API credentials belong here.
EDGE_CDP_URL=http://127.0.0.1:9333
EDGE_AUTO_LAUNCH=true
EDGE_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
EDGE_USER_DATA_DIR=.mcp-edge-profile
EDGE_REQUIRE_DEDICATED_PROFILE=true
EDGE_KEEP_OPEN=true
EDGE_BRING_TO_FRONT=true
EDGE_HEADLESS=false
EDGE_AUTO_CLOSE_TABS=true
EDGE_CLEAR_SESSION_TABS_ON_START=true
EDGE_TAB_IDLE_TIMEOUT_MS=0
EDGE_POPUP_QUIET_MS=200
ALLOW_REMOTE_CDP=false
