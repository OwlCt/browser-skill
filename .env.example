# Official OpenAI: https://api.openai.com/v1
# Third-party providers: use the provider's Responses-compatible /v1 base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6

# "manual" resends Responses items and works with more third-party providers.
# "previous" uses previous_response_id and requires server-side response state.
RESPONSES_STATE_MODE=manual
# Use "minimal" only when a third-party endpoint rejects optional Responses fields.
RESPONSES_COMPAT_MODE=standard
OPENAI_STORE=false
OPENAI_TIMEOUT_MS=120000
BROWSER_MAX_STEPS=40

EDGE_CDP_URL=http://127.0.0.1:9222
EDGE_AUTO_LAUNCH=true
EDGE_EXECUTABLE=
EDGE_USER_DATA_DIR=
EDGE_REQUIRE_DEDICATED_PROFILE=false
EDGE_KEEP_OPEN=true
EDGE_BRING_TO_FRONT=true
EDGE_HEADLESS=false
BROWSER_PRODUCT=edge
BROWSER_CHROME_EXECUTABLE=
BROWSER_CHROME_USER_DATA_DIR=
EDGE_DISABLE_EXTENSIONS=true
EDGE_STEALTH=false
EDGE_CONNECTION_MODE=managed
EDGE_PROFILE_TARGET=dedicated
EDGE_PROFILE_DIRECTORY=Default
EDGE_AUTO_CLOSE_TABS=false
EDGE_CLEAR_SESSION_TABS_ON_START=false
EDGE_TAB_IDLE_TIMEOUT_MS=0
EDGE_POPUP_QUIET_MS=200
ALLOW_REMOTE_CDP=false

# ask requires browser_site approval for each non-loopback origin.
# allow keeps the previous behavior and does not ask.
BROWSER_SITE_POLICY=ask
# Optional comma-separated origins, for example:
# BROWSER_ALLOWED_ORIGINS=https://example.com,http://localhost:3000
BROWSER_ALLOWED_ORIGINS=
BROWSER_MAX_TEXT_CHARS=20000
BROWSER_INLINE_SCREENSHOTS=false
BROWSER_ARTIFACTS_DIR=artifacts
